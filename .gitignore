# Залежності
node_modules/

# Секрети
.env

# База даних та бекапи
orders.db
orders.db-journal
orders.db-wal
orders.db-shm
backups/
.claude/

# Приватні матеріали (не для публікації): таблиці реклами, ключові слова тощо
_private/
*.xlsx

# Робочі специфікації та плани розробки - лишаються локально, не публікуються.
# Увага: файли, що вже потрапили в історію, лишаються читабельними у старих комітах -
# .gitignore прибирає їх лише з поточного дерева.
docs/superpowers/

# Тимчасові файли FUSE (зʼявляються при видаленні відкритого файлу)
.fuse_hidden*

# dev server logs
*.log
