# Шаблон конфігурації. Скопіюй у файл .env та заповни своїми даними:
#   copy .env.example .env   (Windows)

# Доступ до API перевізника contrabus
API_LOGIN=
API_PASSWORD=

# Пароль для входу в панель менеджера (admin.html)
ADMIN_KEY=change-me

# Telegram-бот (необов'язково): сповіщення про заявки + кнопки керування
# Токен — від @BotFather; CHAT_ID — id групи/чату (для групи зі знаком мінус)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Публічна адреса сайту після викладки на хостинг (для посилання в Telegram)
# PUBLIC_BASE_URL=https://your-domain.com
